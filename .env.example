APP_ENV=development
APP_NAME=AI Opportunity Hunter
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/opportunity_hunter
LOG_LEVEL=INFO
EXECUTION_BACKEND=direct

LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_ANALYSIS=deepseek/deepseek-v4-pro
LLM_MODEL_EXTRACTION=deepseek/deepseek-v4-pro
LLM_MODEL_COPY=deepseek/deepseek-v4-pro
ENABLE_LLM_ANALYSIS=false

DISCOVERY_PROVIDER=fixture
AUDIT_PROVIDER=fixture
SHEETS_PROVIDER=fixture
GOOGLE_MAPS_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_CLIENT_SECRETS_JSON=
GOOGLE_OAUTH_TOKEN_JSON=
GOOGLE_SHEETS_USER_EMAIL=
GOOGLE_SHEETS_SPREADSHEET_ID=
BACKEND_INTERNAL_TOKEN=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EXPORT_DIRECTORY=artifacts/exports
